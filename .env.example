# Browser-facing application URL. Used by web page objects and web tests.
WEB_BASE_URL=https://example.test

# API endpoint URL. Used by the Playwright API request client.
API_BASE_URL=https://api.example.test

# Optional credential values. Replace only in a local .env file or CI secrets.
API_TOKEN=
TEST_USERNAME=
TEST_PASSWORD=

# Set to false for headed local execution.
HEADLESS=true

# CI detection is normally supplied by the CI provider.
CI=false
