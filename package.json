{
  "name": "genai-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript Playwright framework for web and API testing.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:web": "playwright test tests/web",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "browsers:install": "playwright install",
    "report": "playwright show-report playwright-report",
    "clean": "rimraf test-results playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  }
}
